(
    fn maxPkgEntryEnsureSlash folderPath = (
        if (folderPath == undefined or folderPath == "") do return ""
        if ((substring folderPath folderPath.count 1) == "\\") do return folderPath
        return folderPath + "\\"
    )

    fn maxPkgEntryStringLiteral sourceContent = (
        local literalContent = sourceContent as string
        literalContent = substituteString literalContent "\\" "\\\\"
        literalContent = substituteString literalContent "\"" "\\\""
        return "\"" + literalContent + "\""
    )

    fn maxPkgEntryForwardPathLiteral sourceFilePath = (
        local literalContent = sourceFilePath as string
        literalContent = substituteString literalContent "\\" "/"
        literalContent = substituteString literalContent "\"" "\\\""
        return "\"" + literalContent + "\""
    )

    fn maxPkgEntryWriteTextFile targetFilePath fileContent = (
        local fileStream = undefined
        try (
            fileStream = createFile targetFilePath
            if (fileStream == undefined) do return false
            format "%" fileContent to: fileStream
            close fileStream
            return true
        ) catch (
            try (if (fileStream != undefined) do close fileStream) catch()
            return false
        )
    )

    fn maxPkgEntryMacroNameFromGuid packageGuid = (
        return "MaxPkg_" + (substituteString packageGuid "-" "")
    )

    fn maxPkgEntryMacroNameFromTitle packageGuid buttonTitle = (
        local cleanTitle = substituteString (buttonTitle as string) " " ""
        if (cleanTitle == undefined or cleanTitle == "") do cleanTitle = "Macro"
        return "MaxPkg_" + (substituteString packageGuid "-" "") + "_" + cleanTitle
    )

    fn maxPkgEntryBuildMacroScriptForFile entryFolder packageGuid macroScriptTitle packageButtonText entryFileRel = (
        local manifestFilePath = entryFolder + "manifest.ini"
        local packageIcon = getINISetting manifestFilePath "package" "icon"
        local macroIconFilePath = (maxPkgEntryEnsureSlash (getDir #userIcons)) + packageGuid + ".svg"
        local macroContent = ""
        if (packageButtonText == undefined or packageButtonText == "") do packageButtonText = macroScriptTitle
        macroContent += "macroScript " + macroScriptTitle + "\n"
        macroContent += "category: \"MaxPkg\"\n"
        macroContent += "buttonText: " + (maxPkgEntryStringLiteral packageButtonText) + "\n"
        macroContent += "tooltip: " + (maxPkgEntryStringLiteral ("Run " + packageButtonText)) + "\n"
        if (packageIcon != undefined and packageIcon != "") do macroContent += "iconName: " + (maxPkgEntryForwardPathLiteral macroIconFilePath) + "\n"
        macroContent += "(\n"
        macroContent += "    on execute do\n"
        macroContent += "    (\n"
        macroContent += "        -- Generated by MaxPkg. https://maxpkg.dev\n"
        macroContent += "        -- This extra macro was created during package installation.\n"
        macroContent += "        -- Package GUID: " + packageGuid + "\n"
        macroContent += "        try\n"
        macroContent += "        (\n"
        macroContent += "            local packageGuid = " + (maxPkgEntryStringLiteral packageGuid) + "\n"
        macroContent += "            local packageDir = (getDir #temp) + " + (maxPkgEntryStringLiteral "\\") + " + packageGuid + " + (maxPkgEntryStringLiteral "\\") + "\n"
        macroContent += "            local packageEntryFile = " + (maxPkgEntryStringLiteral entryFileRel) + "\n"
        macroContent += "            local packageEntryPath = packageDir + packageEntryFile\n"
        macroContent += "            local packageEntryExt = toLower (getFilenameType packageEntryPath)\n"
        macroContent += "            if (not (doesFileExist packageEntryPath)) do throw (" + (maxPkgEntryStringLiteral "Package extra macro file was not found: ") + " + packageEntryPath)\n"
        macroContent += "            if (packageEntryExt == " + (maxPkgEntryStringLiteral ".py") + ") then python.ExecuteFile packageEntryPath else if (packageEntryExt == " + (maxPkgEntryStringLiteral ".ms") + " or packageEntryExt == " + (maxPkgEntryStringLiteral ".mse") + ") then fileIn packageEntryPath else throw (" + (maxPkgEntryStringLiteral "Unsupported package extra macro file type: ") + " + packageEntryExt)\n"
        macroContent += "        )\n"
        macroContent += "        catch\n"
        macroContent += "        (\n"
        macroContent += "            messageBox (" + (maxPkgEntryStringLiteral "Could not run MaxPkg extra macro.") + " + getCurrentException()) title: " + (maxPkgEntryStringLiteral "MaxPkg") + "\n"
        macroContent += "        )\n"
        macroContent += "    )\n"
        macroContent += ")\n"
        return macroContent
    )

    fn maxPkgEntryInstallIcon entryFolder packageGuid = (
        local sourceIconFile = entryFolder + "icons\\icon.svg"
        local targetIconFile = (maxPkgEntryEnsureSlash (getDir #userIcons)) + packageGuid + ".svg"
        if (not (doesFileExist sourceIconFile)) do return true
        try (
            if (doesFileExist targetIconFile) do deleteFile targetIconFile
            copyFile sourceIconFile targetIconFile
            return true
        ) catch (
            messageBox ("Could not install package icon:\n" + targetIconFile + "\n\n" + getCurrentException()) title: "MaxPkg"
            return false
        )
    )

    fn maxPkgEntryBuildMacroScript entryFolder packageGuid = (
        local manifestFilePath = entryFolder + "manifest.ini"
        local packageButtonText = getINISetting manifestFilePath "package" "buttonName"
        local packageIcon = getINISetting manifestFilePath "package" "icon"
        local macroIconFilePath = (maxPkgEntryEnsureSlash (getDir #userIcons)) + packageGuid + ".svg"
        local macroContent = ""
        if (packageButtonText == undefined or packageButtonText == "") do packageButtonText = packageGuid
        macroContent += "macroScript " + (maxPkgEntryMacroNameFromGuid packageGuid) + "\n"
        macroContent += "category: \"MaxPkg\"\n"
        macroContent += "buttonText: " + (maxPkgEntryStringLiteral packageButtonText) + "\n"
        macroContent += "tooltip: " + (maxPkgEntryStringLiteral ("Run " + packageButtonText)) + "\n"
        if (packageIcon != undefined and packageIcon != "") do macroContent += "iconName: " + (maxPkgEntryForwardPathLiteral macroIconFilePath) + "\n"
        macroContent += "(\n"
        macroContent += "    on execute do\n"
        macroContent += "    (\n"
        macroContent += "        -- Generated by MaxPkg. https://maxpkg.dev\n"
        macroContent += "        -- This file was created during package installation for the current 3ds Max profile.\n"
        macroContent += "        -- Package GUID: " + packageGuid + "\n"
        macroContent += "        try\n"
        macroContent += "        (\n"
        macroContent += "            local packageGuid = " + (maxPkgEntryStringLiteral packageGuid) + "\n"
        macroContent += "            local packageDir = (getDir #temp) + " + (maxPkgEntryStringLiteral "\\") + " + packageGuid + " + (maxPkgEntryStringLiteral "\\") + "\n"
        macroContent += "            local manifestIni = packageDir + " + (maxPkgEntryStringLiteral "manifest.ini") + "\n"
        macroContent += "            if (not (doesFileExist manifestIni)) do throw (" + (maxPkgEntryStringLiteral "Package manifest was not found: ") + " + manifestIni)\n"
        macroContent += "            local entry = getINISetting manifestIni " + (maxPkgEntryStringLiteral "package") + " " + (maxPkgEntryStringLiteral "entry") + "\n"
        macroContent += "            if (entry == undefined or entry == " + (maxPkgEntryStringLiteral "") + ") do throw " + (maxPkgEntryStringLiteral "Package entry file is empty.") + "\n"
        macroContent += "            local entryPath = packageDir + entry\n"
        macroContent += "            local entryExt = toLower (getFilenameType entryPath)\n"
        macroContent += "            if (not (doesFileExist entryPath)) do throw (" + (maxPkgEntryStringLiteral "Package entry file was not found: ") + " + entryPath)\n"
        macroContent += "            if (entryExt == " + (maxPkgEntryStringLiteral ".py") + ") then python.ExecuteFile entryPath else if (entryExt == " + (maxPkgEntryStringLiteral ".ms") + " or entryExt == " + (maxPkgEntryStringLiteral ".mse") + ") then fileIn entryPath else throw (" + (maxPkgEntryStringLiteral "Unsupported package entry file type: ") + " + entryExt)\n"
        macroContent += "        )\n"
        macroContent += "        catch\n"
        macroContent += "        (\n"
        macroContent += "            messageBox (" + (maxPkgEntryStringLiteral "Could not run MaxPkg package.\n") + " + getCurrentException()) title: " + (maxPkgEntryStringLiteral "MaxPkg") + "\n"
        macroContent += "        )\n"
        macroContent += "    )\n"
        macroContent += ")\n"
        return macroContent
    )

    fn maxPkgEntryInstallMacroButton entryFolder packageGuid = (
        local manifestFilePath = entryFolder + "manifest.ini"
        local createMacroButton = getINISetting manifestFilePath "package" "createMacroButton"
        local macroFilePath = (maxPkgEntryEnsureSlash (getDir #userMacros)) + "maxpkg-" + packageGuid + ".mcr"
        local macroContent = ""
        if (createMacroButton == undefined) do createMacroButton = ""
        createMacroButton = toLower createMacroButton
        if (createMacroButton != "true") do return true
        maxPkgEntryInstallIcon entryFolder packageGuid
        macroContent = maxPkgEntryBuildMacroScript entryFolder packageGuid
        if (not (maxPkgEntryWriteTextFile macroFilePath macroContent)) do (
            messageBox ("Could not create package macro button:\n" + macroFilePath) title: "MaxPkg"
            return false
        )
        try (fileIn macroFilePath; return true) catch (messageBox ("Could not load package macro button:\n" + macroFilePath + "\n\n" + getCurrentException()) title: "MaxPkg"; return false)
    )

    fn maxPkgEntryInstallExtraMacroButtons entryFolder packageGuid = (
        local manifestFilePath = entryFolder + "manifest.ini"
        local macroCount = try ((getINISetting manifestFilePath "extraMacros" "count") as integer) catch(0)
        maxPkgEntryInstallIcon entryFolder packageGuid
        for macroIndex in 1 to macroCount do (
            local indexPrefix = macroIndex as string
            local macroFileRel = getINISetting manifestFilePath "extraMacros" (indexPrefix + "_file")
            local packageButtonText = getINISetting manifestFilePath "extraMacros" (indexPrefix + "_button")
            local macroSuffix = getINISetting manifestFilePath "extraMacros" (indexPrefix + "_macro")
            if (macroFileRel != undefined and macroFileRel != "" and packageButtonText != undefined and packageButtonText != "") do (
                if (macroSuffix == undefined or macroSuffix == "") do macroSuffix = substituteString packageButtonText " " ""
                local macroScriptTitle = maxPkgEntryMacroNameFromTitle packageGuid macroSuffix
                local macroFilePath = (maxPkgEntryEnsureSlash (getDir #userMacros)) + "maxpkg-" + packageGuid + "-" + macroSuffix + ".mcr"
                local macroContent = maxPkgEntryBuildMacroScriptForFile entryFolder packageGuid macroScriptTitle packageButtonText macroFileRel
                if (not (maxPkgEntryWriteTextFile macroFilePath macroContent)) then (
                    messageBox ("Could not create extra macro button:\n" + macroFilePath) title: "MaxPkg"
                ) else (
                    try (fileIn macroFilePath) catch (messageBox ("Could not load extra macro button:\n" + macroFilePath + "\n\n" + getCurrentException()) title: "MaxPkg")
                )
            )
        )
        return true
    )

    fn maxPkgEntryHasQuadMenuItems entryFolder = (
        local manifestFilePath = entryFolder + "manifest.ini"
        local macroCount = try ((getINISetting manifestFilePath "extraMacros" "count") as integer) catch(0)
        for macroIndex in 1 to macroCount do (
            local indexPrefix = macroIndex as string
            if ((toLower (getINISetting manifestFilePath "extraMacros" (indexPrefix + "_quad"))) == "true") do return true
        )
        return false
    )

    fn maxPkgEntryBuildQuadStartupScript entryFolder = (
        local helperFilePath = entryFolder + "maxpkg-quad.ms"
        local commandContent = "(MaxPkgQuadMenuManagerData packageFolder: " + (maxPkgEntryStringLiteral entryFolder) + ").install()"
        local startupContent = ""
        startupContent += "(\n"
        startupContent += "    try (\n"
        startupContent += "        local helperFilePath = " + (maxPkgEntryStringLiteral helperFilePath) + "\n"
        startupContent += "        if (doesFileExist helperFilePath) do (\n"
        startupContent += "            fileIn helperFilePath\n"
        startupContent += "            execute " + (maxPkgEntryStringLiteral commandContent) + "\n"
        startupContent += "        )\n"
        startupContent += "    ) catch()\n"
        startupContent += ")\n"
        return startupContent
    )

    fn maxPkgEntryInstallQuadMenu entryFolder packageGuid = (
        local helperFilePath = entryFolder + "maxpkg-quad.ms"
        local startupFilePath = (maxPkgEntryEnsureSlash (getDir #userStartupScripts)) + "maxpkg-" + packageGuid + "-quad-startup.ms"
        if (not (maxPkgEntryHasQuadMenuItems entryFolder)) do (
            try (if (doesFileExist startupFilePath) do deleteFile startupFilePath) catch()
            return true
        )
        if (not (doesFileExist helperFilePath)) do return false
        local startupContent = maxPkgEntryBuildQuadStartupScript entryFolder
        if (not (maxPkgEntryWriteTextFile startupFilePath startupContent)) do (
            messageBox ("Could not create package Quad Menu startup script:\n" + startupFilePath) title: "MaxPkg"
            return false
        )
        try (
            fileIn helperFilePath
            local commandContent = "(MaxPkgQuadMenuManagerData packageFolder: " + (maxPkgEntryStringLiteral entryFolder) + ").install()"
            local isQuadMenuInstalled = execute commandContent
            if (isQuadMenuInstalled != true) do throw "Quad Menu API did not accept the package commands."
            return true
        ) catch (
            messageBox ("Could not install package Quad Menu commands:\n" + getCurrentException()) title: "MaxPkg"
            return false
        )
    )

    fn maxPkgEntryRunOptionalScript scriptFilePath = (
        if (scriptFilePath == undefined or scriptFilePath == "") do return false
        if (not (doesFileExist scriptFilePath)) do return true
        try (fileIn scriptFilePath; return true) catch (messageBox ("Could not run package script:\n" + scriptFilePath + "\n\n" + getCurrentException()) title: "MaxPkg"; return false)
    )

    local entryFolder = maxPkgEntryEnsureSlash (getFilenamePath (getSourceFileName()))
    local manifestFilePath = entryFolder + "manifest.ini"
    local packageGuid = getINISetting manifestFilePath "package" "packageGuid"
    if (packageGuid == undefined or packageGuid == "") then (
        messageBox ("Package GUID was not found in manifest:\n" + manifestFilePath) title: "MaxPkg"
    ) else (
        maxPkgEntryInstallMacroButton entryFolder packageGuid
        maxPkgEntryInstallExtraMacroButtons entryFolder packageGuid
        maxPkgEntryInstallQuadMenu entryFolder packageGuid
        maxPkgEntryRunOptionalScript (entryFolder + "_install.ms")
        try (if (MaxPkg != undefined and isProperty MaxPkg #packageInstalled) do MaxPkg.packageInstalled packageGuid) catch()
    )
)
